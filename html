      </div>


      <div class="journal-list">

        <article class="journal-card fade-in">

          <img
            src="https://images.unsplash.com/photo-1746387402738-eb509c19c2c3?auto=format&fit=crop&w=900&q=85"
            alt="森の中の光"
          >

          <div class="journal-card-content">

            <p class="journal-date">
