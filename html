          </a>

        </div>

      </div>

    </section>



    <!-- =========================
         JOURNAL
    ========================== -->

    <section class="journal" id="journal">

      <div class="fade-in">

        <p class="section-label">
          JOURNAL
        </p>

        <h2 class="section-title">
          日々のこと。
        </h2>

        <p class="section-intro">
