<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>たの｜自由になる途中。</title>

  <meta
    name="description"
    content="たの。仕事も、遊びも、創作も。いろんなことを試しながら、自由になる途中。"
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Zen+Old+Mincho&display=swap"
    rel="stylesheet"
  >

  <style>

    /* =========================
       RESET
    ========================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: #f7f7f1;
      color: #26352b;
      font-family: "Zen Kaku Gothic New", sans-serif;
      line-height: 1.8;
      overflow-x: hidden;
    }

    img {
      width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }


    /* =========================
       COLOR
    ========================= */

    :root {
      --green-dark: #234b35;
      --green: #477957;
      --green-light: #dce8d9;
      --cream: #f7f7f1;
      --beige: #ece9dd;
      --text: #26352b;
      --white: #ffffff;
    }


    /* =========================
       HEADER
    ========================= */

    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 100;

      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 24px 5vw;

      background: rgba(247, 247, 241, 0.78);
      backdrop-filter: blur(12px);

      border-bottom: 1px solid rgba(35, 75, 53, 0.08);
    }

    .logo {
      font-family: "Zen Old Mincho", serif;
      font-size: 25px;
      letter-spacing: 0.08em;
      color: var(--green-dark);
    }

    nav {
      display: flex;
      gap: 30px;
      font-size: 13px;
      letter-spacing: 0.12em;
    }

    nav a {
      position: relative;
    }

    nav a::after {
      content: "";
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--green);
      transition: 0.3s;
    }

    nav a:hover::after {
      width: 100%;
    }


    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 100vh;
      position: relative;

      display: flex;
      align-items: center;

      padding: 150px 8vw 100px;

      overflow: hidden;
    }

    .hero-image {
      position: absolute;
      right: 0;
      top: 0;

      width: 65%;
      height: 100%;

      object-fit: cover;

      opacity: 0.9;

      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 25%
      );
    }

    .hero-overlay {
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          90deg,
          var(--cream) 0%,
          rgba(247,247,241,0.93) 28%,
          rgba(247,247,241,0.15) 75%
        );
    }

    .hero-content {
      position: relative;
      z-index: 2;

      max-width: 650px;
    }

    .hero-small {
      font-size: 13px;
      letter-spacing: 0.25em;
      color: var(--green);
      margin-bottom: 25px;
    }

    .hero-title {
      font-family: "Zen Old Mincho", serif;

      font-size: clamp(60px, 9vw, 120px);

      line-height: 1.05;
      letter-spacing: 0.03em;

      color: var(--green-dark);

      margin-bottom: 30px;
    }

    .hero-title span {
      display: block;
      font-size: 0.42em;
      margin-left: 10px;
      letter-spacing: 0.18em;
    }

    .hero-description {
      font-size: 15px;
      line-height: 2.2;

      max-width: 430px;

      color: #526257;
    }

    .scroll {
      position: absolute;
      bottom: 35px;
      left: 8vw;

      font-size: 10px;
      letter-spacing: 0.3em;
      color: var(--green);

      writing-mode: vertical-rl;
    }


    /* =========================
       COMMON
    ========================= */

    section {
      padding: 130px 8vw;
    }

    .section-label {
      font-size: 11px;
      letter-spacing: 0.25em;
      color: var(--green);
      margin-bottom: 15px;
    }

    .section-title {
      font-family: "Zen Old Mincho", serif;
      font-size: clamp(35px, 5vw, 58px);
      line-height: 1.35;
      color: var(--green-dark);
    }

    .section-intro {
      margin-top: 25px;
      max-width: 600px;
      color: #627067;
      font-size: 14px;
    }


    /* =========================
       ABOUT
    ========================= */

    .about {
      background: #e8eee4;
    }

    .about-grid {
      margin-top: 70px;

      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 8vw;

      align-items: center;
    }

    .about-photo {
      height: 600px;
      object-fit: cover;
    }

    .about-text {
      max-width: 500px;
    }

    .about-text h3 {
      font-family: "Zen Old Mincho", serif;
      font-size: 30px;
      font-weight: 400;
      margin-bottom: 25px;
    }

    .about-text p {
      font-size: 14px;
      color: #56635a;
      margin-bottom: 20px;
    }

    .about-more {
      display: inline-block;
      margin-top: 20px;

      padding-bottom: 6px;

      font-size: 12px;
      letter-spacing: 0.15em;

      border-bottom: 1px solid var(--green);
    }


    /* =========================
       JOURNAL
    ========================= */

    .journal {
      background: var(--cream);
    }

    .journal-list {
      margin-top: 70px;

      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 25px;
    }

    .journal-card {
      background: white;
      transition: transform 0.4s ease;
    }

    .journal-card:hover {
      transform: translateY(-8px);
    }

    .journal-card img {
      height: 270px;
      object-fit: cover;
    }

    .journal-card-content {
      padding: 25px;
    }

    .journal-date {
      font-size: 10px;
      letter-spacing: 0.15em;
      color: #89958d;
      margin-bottom: 10px;
    }

    .journal-card h3 {
      font-family: "Zen Old Mincho", serif;
      font-size: 21px;
      font-weight: 400;
      margin-bottom: 12px;
    }

    .journal-card p {
      font-size: 12px;
      color: #68736c;
    }


    /* =========================
       CREATE
    ========================= */

    .create {
      background: var(--green-dark);
      color: white;
    }

    .create .section-label {
      color: #b8d2bb;
    }

    .create .section-title {
      color: white;
    }

    .create .section-intro {
      color: #c8d4ca;
    }

    .create-grid {
      margin-top: 70px;

      display: grid;
      grid-template-columns: 1.4fr 1fr;

      gap: 25px;
    }

    .create-main {
      position: relative;
      min-height: 600px;
      overflow: hidden;
    }

    .create-main img {
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s ease;
    }

    .create-main:hover img {
      transform: scale(1.04);
    }

    .create-main-content {
      position: absolute;
      left: 35px;
      bottom: 35px;

      color: white;
      z-index: 2;
    }

    .create-main-content h3 {
      font-family: "Zen Old Mincho", serif;
      font-size: 40px;
      font-weight: 400;
    }

    .create-main-content p {
      font-size: 12px;
    }

    .create-side {
      display: grid;
      gap: 25px;
    }

    .create-card {
      position: relative;
      min-height: 287px;
      overflow: hidden;
    }

    .create-card img {
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s ease;
    }

    .create-card:hover img {
      transform: scale(1.05);
    }

    .create-card-content {
      position: absolute;
      bottom: 25px;
      left: 25px;

      z-index: 2;
      color: white;
    }

    .create-card-content h3 {
      font-family: "Zen Old Mincho", serif;
      font-size: 27px;
      font-weight: 400;
    }

    .create-card::after,
    .create-main::after {
      content: "";
      position: absolute;
      inset: 0;

      background: linear-gradient(
        transparent 30%,
        rgba(0,0,0,0.65)
      );
    }


    /* =========================
       VIDEO
    ========================= */

    .video {
      background: #f0eee5;
    }

    .video-box {
      margin-top: 65px;

      min-height: 430px;

      display: flex;
      justify-content: center;
      align-items: center;

      background:
        linear-gradient(
          rgba(30, 70, 48, 0.55),
          rgba(30, 70, 48, 0.55)
        ),
        url("https://images.unsplash.com/photo-1589122125915-17d16a9541c8?auto=format&fit=crop&w=1800&q=85")
        center / cover;

      color: white;
      text-align: center;
    }

    .video-inner h3 {
      font-family: "Zen Old Mincho", serif;
      font-size: 42px;
      font-weight: 400;
      margin-bottom: 15px;
    }

    .video-inner p {
      font-size: 13px;
      margin-bottom: 30px;
    }

    .video-button {
      display: inline-block;

      padding: 13px 30px;

      border: 1px solid rgba(255,255,255,0.8);

      font-size: 11px;
      letter-spacing: 0.2em;

      transition: 0.3s;
    }

    .video-button:hover {
      background: white;
      color: var(--green-dark);
    }


    /* =========================
       LINKS
    ========================= */

    .links {
      text-align: center;
      background: #dfe8dc;
    }

    .links-grid {
      margin-top: 55px;

      display: flex;
      justify-content: center;
      flex-wrap: wrap;

      gap: 15px;
    }

    .link-button {
      min-width: 150px;

      padding: 15px 25px;

      border: 1px solid rgba(35,75,53,0.3);

      font-size: 12px;
      letter-spacing: 0.15em;

      transition: 0.3s;
    }

    .link-button:hover {
      background: var(--green-dark);
      color: white;
    }


    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 60px 8vw;

      display: flex;
      justify-content: space-between;
      align-items: center;

      background: var(--green-dark);
      color: white;
    }

    .footer-logo {
      font-family: "Zen Old Mincho", serif;
      font-size: 25px;
    }

    .footer-copy {
      font-size: 10px;
      color: #b8c6ba;
      letter-spacing: 0.12em;
    }


    /* =========================
       ANIMATION
    ========================= */

    .fade-in {
      opacity: 0;
      transform: translateY(35px);

      transition:
        opacity 1s ease,
        transform 1s ease;
    }

    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 800px) {

      header {
        padding: 18px 5vw;
      }

      nav {
        gap: 14px;
        font-size: 10px;
      }

      .hero {
        min-height: 100vh;
        padding: 130px 7vw 80px;
      }

      .hero-image {
        width: 100%;
        opacity: 0.45;

        mask-image: none;
      }

      .hero-overlay {
        background:
          linear-gradient(
            90deg,
            rgba(247,247,241,0.95),
            rgba(247,247,241,0.65)
          );
      }

      .hero-title {
        font-size: 72px;
      }

      section {
        padding: 90px 7vw;
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 45px;
      }

      .about-photo {
        height: 430px;
      }

      .journal-list {
        grid-template-columns: 1fr;
      }

      .journal-card img {
        height: 240px;
      }

      .create-grid {
        grid-template-columns: 1fr;
      }

      .create-main {
        min-height: 430px;
      }

      .create-card {
        min-height: 260px;
      }

      .video-box {
        min-height: 380px;
      }

      .video-inner h3 {
        font-size: 32px;
      }

      footer {
        flex-direction: column;
        gap: 20px;
        text-align: center;
      }

    }

  </style>
</head>


<body>


  <!-- =========================
       HEADER
  ========================== -->

  <header>

    <a href="#" class="logo">
      たの
    </a>

    <nav>
      <a href="#about">ABOUT</a>
      <a href="#journal">JOURNAL</a>
      <a href="#create">CREATE</a>
      <a href="#video">VIDEO</a>
    </nav>

  </header>



  <!-- =========================
       HERO
  ========================== -->

  <main>

    <section class="hero">

      <img
        class="hero-image"
        src="https://images.unsplash.com/photo-1771094045880-ba0d3245b51e?auto=format&fit=crop&w=2000&q=85"
        alt="木漏れ日の森"
      >

      <div class="hero-overlay"></div>

      <div class="hero-content">

        <p class="hero-small">
