        </p>

      </div>

      <div class="scroll">
        SCROLL
      </div>

    </section>



    <!-- =========================
         ABOUT
    ========================== -->

    <section class="about" id="about">

      <div class="fade-in">

        <p class="section-label">
          ABOUT ME
        </p>

        <h2 class="section-title">
          自分の人生を、<br>
